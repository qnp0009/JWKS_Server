# Copy to .env and adjust. Every variable is optional; defaults are for local use.
# Bind to loopback unless other services on the network must reach this process.
JWKS_HOST=127.0.0.1
JWKS_PORT=8000

# Value placed in the JWT iss claim.
JWKS_ISSUER=jwks-server

# RSA modulus size. Minimum 2048.
JWKS_RSA_KEY_SIZE=2048

# How long a newly generated key stays in the JWKS after it becomes active.
JWKS_KEY_LIFETIME_SECONDS=86400

# How often to publish the next signing key. Keep this shorter than the lifetime
# so the previous public key remains available while older tokens are still valid.
JWKS_ROTATION_INTERVAL_SECONDS=43200
JWKS_AUTO_ROTATE=true

# Lifetime of a normal access token.
JWKS_TOKEN_TTL_SECONDS=3600

# memory | file | sqlite
JWKS_STORAGE_BACKEND=memory
# Used by file and sqlite. Ignored for memory.
# JWKS_STORAGE_PATH=data/keystore.json

# When set, POST /auth, POST /sign, and /keys require header X-Admin-Key.
# Leave empty only on a trusted local machine.
JWKS_ADMIN_API_KEY=

# Comma-separated browser origins, or * for any origin.
JWKS_CORS_ORIGINS=*

# Requests each client address may make in any one-second window. 0 disables the limit.
JWKS_RATE_LIMIT_PER_SECOND=10
